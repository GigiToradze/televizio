# Copy to .env and fill in from the Supabase dashboard. .env is gitignored.
#
# Project ref, anon key, service role key:
#   Project Settings -> API
# Session pooler connection string (NOT the transaction pooler - the pgTAP
# tests need transactions):
#   Project Settings -> Database -> Connection string -> Session pooler

SUPABASE_PROJECT_REF=
SUPABASE_URL=https://YOUR_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
DATABASE_URL=postgresql://postgres.YOUR_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
